{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bruno/.codex/hooks/deny-rm-rf.jq",
            "statusMessage": "Checking command",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '💡 Reminder: Use /log-session at the end of this session to save a summary to your work notes.'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/.config/caveman/rules.md\"",
            "statusMessage": "Loading shared Caveman rules",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
