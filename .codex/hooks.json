{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/deny-rm-rf.jq\"",
            "statusMessage": "Checking command",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/verify-on-stop.py\"",
            "statusMessage": "Recording verification evidence",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '💡 Reminder: Use /log-session at the end of this session to save a summary to your work notes.'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/verify-on-stop.py\"",
            "statusMessage": "Checking verification evidence",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
