{
  "env": {
    "OBSIDIAN_VAULT_DIR": "/Volumes/NAS/bruno/vault"
  },
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-rm-rf.jq"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '💡 Reminder: Use /log-session at the end of this session to save a summary to your work notes.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/bruno/.claude/hooks/verify-on-stop.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/bruno/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "model": "claude-fable-5-1[1m]"
}
