[user]
  name = Bruno Silveira
  email = djbrunosilveira@gmail.com

[core]
  editor = nvim
  whitespace = trailing-space,cr-at-eol
  excludesfile = ~/.gitignore
  autocrlf = false

[merge]
  ff = only

[diff]
  mnemonicprefix = true
  compactionHeuristic = true

[alias]
  # Essential aliases for occasional CLI use
  st = status --short --branch
  cm = commit -av
  unstage = reset HEAD
  pf = push --force-with-lease

[push]
  default = current

[status]
  showUntrackedFiles = all

[rerere]
  enabled = 1

# OS-specific settings (credential helper). link.sh picks gitconfig.macos or
# gitconfig.linux and links it to ~/.gitconfig.os
[include]
  path = ~/.gitconfig.os

# Claude Code writes /model and /effort choices into ~/.claude/settings.json,
# which links into the dotfiles repo. Hide those keys from git there
# (applied via the repo's .gitattributes).
[filter "claude-settings"]
  clean = jq --indent 2 'del(.model, .modelSettings)'

[commit]
  verbose = true

[fetch]
  prune = true

[gh]
  autoUpdate = never

[color]
  ui = auto

[rebase]
  autosquash = true
  autostash = true
