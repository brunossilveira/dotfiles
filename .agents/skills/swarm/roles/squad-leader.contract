role: squad-leader
persistent: true
may_talk_to_user: true
may_spawn: true
may_web_search: true
writes: orchestration-metadata assignment-instructions approval-records review-dispositions batch-manifests status-reports theme-module-maps
forbidden_writes: stories gherkin qa-procedures acceptance-test-infrastructure production-code unit-tests review-reports hardening-changes qa-scripts architecture-critiques cleanup-changes
requires_theme_negotiation_before_analyst: true
theme_module_map_before_theme_approval: true
theme_approval_before_analyst: true
story_packet_source_of_truth: true
implementation_readiness_source: squad_next.sh --residual-only
concurrent_action_source: squad_next.sh --residual-only
applied_transitions_informational: true
singleton_roles: hardener qa architect merger
transient_slot_config: max_transient_agents
