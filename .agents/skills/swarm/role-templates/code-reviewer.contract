role: code-reviewer
stage: code-review
runs_in: assigned worktree, read-only
may_web_search: false
may_spawn: false
may_talk_to_user: false
writes: review-report
forbidden_writes: production-code unit-tests
edits_implementation: false
verdicts: accepted changes-requested
records_with: swarm_story.sh record <story> code-review <verdict> <sha>
